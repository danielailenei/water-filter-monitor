# Sablon pentru credentialele de alertare (email + push).
#
# Copiaza acest fisier ca ".env.secrets" (in acelasi folder, langa
# docker-compose.yml) si completeaza valorile reale. Fisierul ".env.secrets"
# este exclus explicit din git (vezi .gitignore) - NU se urca niciodata pe
# GitHub, pastreaza-l doar local.
#
# Dupa ce il completezi, reporneste backend-ul:
#   docker compose up -d --build backend

# --- Email (SMTP), pentru alertele la 80% / 90% / infundat ---
# Pentru Gmail: activeaza autentificarea in doi pasi pe contul tau, apoi
# genereaza o "App Password" dedicata la https://myaccount.google.com/apppasswords
# (NU folosi parola reala a contului Google aici).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=adresa-ta@gmail.com
SMTP_PASSWORD=parola-de-aplicatie-16-caractere
ALERT_EMAIL_TO=adresa-unde-primesti-alertele@gmail.com

# --- Push pe telefon, prin ntfy.sh ---
# Instaleaza aplicatia "ntfy" (Android/iOS), aboneaza-te la un topic unic
# (orice sir de caractere greu de ghicit - functioneaza ca o parola simpla,
# fiindca topicurile ntfy.sh publice sunt vizibile oricui il cunoaste) si
# pune acelasi nume aici.
NTFY_TOPIC=alegeti-un-nume-unic-greu-de-ghicit
