# Template for the alerting credentials (email + push).
#
# Copy this file to ".env.secrets" (next to docker-compose.yml) and fill in
# real values. ".env.secrets" is git-ignored (see .gitignore) - keep it local.
#
# After editing, restart the backend:
#   docker compose up -d --build backend

# --- Email (SMTP), for the 80% / 90% / clogged alerts ---
# For Gmail: enable 2-step verification, then create a dedicated App Password
# at https://myaccount.google.com/apppasswords (do NOT use your real password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-address@gmail.com
SMTP_PASSWORD=your-16-char-app-password
ALERT_EMAIL_TO=where-you-want-the-alerts@gmail.com

# --- Phone push, via ntfy.sh ---
# Install the "ntfy" app (Android/iOS), subscribe to a unique topic (any
# hard-to-guess string - it works like a simple password, since public
# ntfy.sh topics are visible to anyone who knows the name) and put it here.
NTFY_TOPIC=pick-a-unique-hard-to-guess-name
