# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/

# Docker volumes (local data, not versioned)
mosquitto/data/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Office lock files ("~$document.docx")
~$*

# Dissertation write-up, diagrams and screenshots - kept local, not in the
# public app repo
docs/

# Real secrets (SMTP password, ntfy topic) - never committed, repo is public.
# See .env.secrets.example for the template.
.env.secrets

# Local .env (development values) - see .env.example for the template
.env

# Terraform
# Providerii si modulele descarcate de `terraform init` (se regeneaza oricum)
.terraform/

# State-ul: ID-uri de resurse si uneori SECRETE in clar. Sta doar in S3.
*.tfstate
*.tfstate.*
# Variabile cu valori reale (IP-ul tau, parole). Exemplele se versioneaza.
*.tfvars
!*.tfvars.example
# Planuri salvate cu `terraform plan -out` (pot contine secrete)
*.tfplan
# Loguri de crash
crash.log
crash.*.log

# Instructiuni locale pentru Claude
CLAUDE.md