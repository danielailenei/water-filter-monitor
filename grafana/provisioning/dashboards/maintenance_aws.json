    {
      "id": 1,
      "title": "CPU (%) pe servicii",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "cloudwatch",
        "uid": "cloudwatch-wfm"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudwatch",
            "uid": "cloudwatch-wfm"
          },
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "namespace": "AWS/ECS",
          "metricName": "CPUUtilization",
          "dimensions": {
            "ClusterName": "wfm-stage",
            "ServiceName": "*"
          },
          "matchExact": true,
          "statistic": "Average",
          "period": "60",
          "region": "default",
          "id": "",
          "expression": "",
          "sqlExpression": "",
          "label": "${PROP('Dim.ServiceName')}"
        }
      ],
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "axisSoftMax": 100
          }
        },
        "overrides": []
      },
      "description": "Backend scalează automat la CPU mediu 50%. Un worker sau InfluxDB la 100% este blocajul."
    },
