{
  "title": "Water Filter Monitor",
  "uid": "water-filter-monitor",
  "timezone": "Europe/Bucharest",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "5s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 5,
      "title": "Grad de înfundare",
      "description": "Presiunea față de pragul de înfundare (1,5 bar), limitat la 100%.",
      "type": "gauge",
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-water-filter"
      },
      "targets": [
        {
          "query": "from(bucket: \"water_filter\") |> range(start: -10m) |> filter(fn: (r) => r._measurement == \"filter_reading\" and r._field == \"pressure_drop_bar\") |> last() |> map(fn: (r) => ({ r with _value: if r._value / 1.5 * 100.0 > 100.0 then 100.0 else r._value / 1.5 * 100.0 }))",
          "refId": "A"
        }
      ],
      "options": {
        "showThresholdMarkers": true,
        "showThresholdLabels": false,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 0,
          "displayName": "înfundare",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 80
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Stare filtru",
      "type": "stat",
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-water-filter"
      },
      "targets": [
        {
          "query": "from(bucket: \"water_filter\") |> range(start: -10m) |> filter(fn: (r) => r._measurement == \"filter_reading\" and r._field == \"is_clogged\") |> last() |> map(fn: (r) => ({ r with _value: if r._value then 1.0 else 0.0 }))",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Funcțional",
                  "color": "green"
                },
                "1": {
                  "text": "ÎNFUNDAT",
                  "color": "red"
                }
              }
            }
          ],
          "noValue": "fără date"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "Presiune diferențială",
