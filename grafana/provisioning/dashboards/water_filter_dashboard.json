    {
      "id": 1,
      "title": "Presiune diferențială (bar)",
      "description": "Linia roșie punctată: pragul de înfundare. Presiunea se apropie de presiunea rețelei (4 bar) când filtrul se blochează.",
      "type": "timeseries",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 7
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-water-filter"
      },
      "targets": [
        {
          "query": "from(bucket: \"water_filter\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn: (r) => r._measurement == \"filter_reading\" and r._field == \"pressure_drop_bar\")",
          "refId": "A"
        }
      ],
      "options": {
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: bar",
          "decimals": 2,
          "min": 0,
          "displayName": "presiune",
          "color": {
            "mode": "fixed",
            "fixedColor": "#38bdf8"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 12,
            "thresholdsStyle": {
              "mode": "dashed"
            },
            "axisSoftMax": 1.6
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "red",
                "value": 1.5
              }
            ]
          }
        },
        "overrides": []
      }
    },
