{
  "title": "Water Filter Monitor",
  "uid": "water-filter-monitor",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Cadere de presiune (bar)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "influxdb", "uid": "influxdb-water-filter" },
      "targets": [
        {
          "query": "from(bucket: \"water_filter\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn: (r) => r._measurement == \"filter_reading\") |> filter(fn: (r) => r._field == \"pressure_drop_bar\")",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "bar", "color": { "mode": "palette-classic" } },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Debit (L/min)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "influxdb", "uid": "influxdb-water-filter" },
      "targets": [
        {
          "query": "from(bucket: \"water_filter\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn: (r) => r._measurement == \"filter_reading\") |> filter(fn: (r) => r._field == \"flow_rate_lmin\")",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "Lmin", "color": { "mode": "palette-classic" } },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Turbiditate (NTU)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "influxdb", "uid": "influxdb-water-filter" },
      "targets": [
        {
          "query": "from(bucket: \"water_filter\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn: (r) => r._measurement == \"filter_reading\") |> filter(fn: (r) => r._field == \"turbidity_ntu\")",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "none", "color": { "mode": "palette-classic" } },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Filtru infundat? (ultima citire)",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "influxdb", "uid": "influxdb-water-filter" },
      "targets": [
        {
          "query": "from(bucket: \"water_filter\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn: (r) => r._measurement == \"filter_reading\") |> filter(fn: (r) => r._field == \"is_clogged\") |> last() |> map(fn: (r) => ({ r with _value: if r._value then 1.0 else 0.0 }))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "OK", "color": "green" }, "1": { "text": "INFUNDAT", "color": "red" } } }
          ]
        },
        "overrides": []
      }
    }
  ]
}
