# Local development values. Copy this file to ".env" (git-ignored).
#
# docker compose reads INFLUX_TOKEN and the two passwords at the bottom from
# ".env". The connection values below are only for running the backend or
# sensor with plain Python outside Docker (export them in your shell - the
# code reads environment variables, it does not load .env itself).

MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_TOPIC=home/water/filter

INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=changeme
INFLUX_ORG=disertatie
INFLUX_BUCKET=water_filter

# Pressure (bar) above which the filter counts as clogged; also the base for
# the 80/90/100% alert thresholds. Keep in sync with sensor/config.yaml.
CLOG_THRESHOLD_BAR=1.5

# Also used by docker-compose.yml when starting the containers - pick your own
# values, do not leave them as "changeme" in a real environment.
INFLUX_ADMIN_PASSWORD=changeme123
GRAFANA_ADMIN_PASSWORD=changeme123
