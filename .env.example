# Valori de referinta pentru dezvoltare locala (docker-compose le are deja hardcodate,
# fisierul asta e util daca rulezi backend-ul sau senzorul direct cu python, in afara Docker).
#
# Copiaza acest fisier ca ".env" si completeaza valorile reale daca difera de
# cele implicite. Fisierul ".env" este exclus din git (vezi .gitignore).

MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_TOPIC=home/water/filter

INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=changeme
INFLUX_ORG=disertatie
INFLUX_BUCKET=water_filter

# Folosite si de docker-compose.yml la pornirea containerelor - alege valori
# proprii, nu le lasa "changeme" intr-un mediu real
INFLUX_ADMIN_PASSWORD=changeme123
GRAFANA_ADMIN_PASSWORD=changeme123
