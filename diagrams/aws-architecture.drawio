Color=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;fillColor=#ED7100;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ecr;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1720" y="120" width="56" height="56" as="geometry"/></mxCell><mxCell id="c56" value="&lt;b&gt;SSM Parameter Store&lt;/b&gt;&lt;br&gt;secrete injectate la pornire + image_tag" style="sketch=0;outlineConnect=0;fontColor=#232F3E;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;fillColor=#E7157B;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.systems_manager;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1720" y="235" width="56" height="56" as="geometry"/></mxCell><mxCell id="c57" value="&lt;b&gt;Cloud Map&lt;/b&gt; — DNS privat *.wfm.local&lt;br&gt;mosquitto și influxdb, rezolvate din VPC" style="sketch=0;outlineConnect=0;fontColor=#232F3E;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;fillColor=#8C4FFF;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloud_map;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1720" y="350" width="56" height="56" as="geometry"/></mxCell><mxCell id="c58" value="&lt;b&gt;CloudWatch&lt;/b&gt;&lt;br&gt;log-uri din toate taskurile, alarme, dashboard" style="sketch=0;outlineConnect=0;fontColor=#232F3E;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;fillColor=#E7157B;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch_2;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1720" y="465" width="56" height="56" as="geometry"/></mxCell><mxCell id="c59" value="&lt;b&gt;Application Auto Scaling&lt;/b&gt;&lt;br&gt;backend 1–3, după alarmele CloudWatch" style="sketch=0;outlineConnect=0;fontColor=#232F3E;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;fillColor=#E7157B;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.application_auto_scaling;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1720" y="580" width="56" height="56" as="geometry"/></mxCell><mxCell id="c60" value="&lt;b&gt;EFS&lt;/b&gt; — datele InfluxDB&lt;br&gt;mount target în fiecare AZ (NFS 2049)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;fillColor=#7AA116;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.elastic_file_system;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1720" y="700" width="56" height="56" as="geometry"/></mxCell><mxCell id="c61" value="&lt;b&gt;S3&lt;/b&gt; — state Terraform&lt;br&gt;(bucket din bootstrap)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;fillColor=#7AA116;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;" vertex="1" parent="1"><mxGeometry x="1720" y="845" width="56" height="56" as="geometry"/></mxCell><mxCell id="c62" value="&lt;b&gt;Straturi Terraform&lt;/b&gt; (state separat în S3)&lt;br&gt;• &lt;b&gt;bootstrap&lt;/b&gt; — bucket-ul de state&lt;br&gt;• &lt;b&gt;shared&lt;/b&gt; — VPC shared, ECR, JumpHost, OIDC, buget&lt;br&gt;• &lt;b&gt;stage-base&lt;/b&gt; — VPC stage, peering, SG, EFS, cluster, SSM, dashboard&lt;br&gt;• &lt;b&gt;stage-app&lt;/b&gt; — &lt;i&gt;la cerere (~0,15 $/h)&lt;/i&gt;: NAT, ALB, CloudFront,&lt;br&gt;&amp;nbsp;&amp;nbsp;Cloud Map, servicii ECS, autoscaling; distrus automat seara" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#AAB7B8;fontColor=#232F3E;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1420" y="1040" width="690" height="140" as="geometry"/></mxCell><mxCell id="c63" value="&lt;b&gt;CI/CD:&lt;/b&gt; PR → ci.yml (fmt, validate, build) · push main → deploy.yml&lt;br&gt;(build ARM64 → ECR → scanare CVE → tag în SSM) · stage.yml create / destroy" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#AAB7B8;fontColor=#232F3E;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1420" y="1196" width="690" height="60" as="geometry"/></mxCell><mxCell id="c64" value="&lt;b&gt;De ce sunt în afara VPC-ului?&lt;/b&gt; S3, ECR, SSM, CloudWatch, Cloud Map și EFS sunt servicii regionale gestionate de AWS: nu rulează în subrețelele noastre. Containerele ajung la ele prin NAT (ECR, SSM, CloudWatch), prin DNS-ul VPC (Cloud Map) sau prin mount target-urile EFS din fiecare AZ. Bucket-ul S3 e folosit doar de Terraform." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#AAB7B8;fontColor=#232F3E;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1420" y="1272" width="690" height="100" as="geometry"/></mxCell><mxCell id="c65" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#545B64;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c24" target="c27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><